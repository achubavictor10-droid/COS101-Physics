
# Physics Formula Calculator

# Function 1: Calculate Speed
def calculate_speed():
    distance = float(input("Enter distance (m): "))
    time = float(input("Enter time (s): "))
    speed = distance / time
    print("Speed =", speed, "m/s")


# Function 2: Calculate Force
def calculate_force():
    mass = float(input("Enter mass (kg): "))
    acceleration = float(input("Enter acceleration (m/s²): "))
    force = mass * acceleration
    print("Force =", force, "N")


# Function 3: Calculate Work Done
def calculate_work():
    force = float(input("Enter force (N): "))
    distance = float(input("Enter distance (m): "))
    work = force * distance
    print("Work Done =", work, "J")


# Function 4: Calculate Density
def calculate_density():
    mass = float(input("Enter mass (kg): "))
    volume = float(input("Enter volume (m³): "))
    density = mass / volume
    print("Density =", density, "kg/m³")


# Function 5: Calculate Kinetic Energy
def calculate_kinetic_energy():
    mass = float(input("Enter mass (kg): "))
    velocity = float(input("Enter velocity (m/s): "))
    kinetic_energy = 0.5 * mass * velocity ** 2
    print("Kinetic Energy =", kinetic_energy, "J")


# Main program
while True:
    print("\n===== PHYSICS FORMULA CALCULATOR =====")
    print("1. Calculate Speed")
    print("2. Calculate Force")
    print("3. Calculate Work Done")
    print("4. Calculate Density")
    print("5. Calculate Kinetic Energy")

    choice = input("\nChoose a formula (1-5): ")

    if choice == "1":
        calculate_speed()

    elif choice == "2":
        calculate_force()

    elif choice == "3":
        calculate_work()

    elif choice == "4":
        calculate_density()

    elif choice == "5":
        calculate_kinetic_energy()

    else:
        print("Invalid choice! Please select between 1 and 5.")

    # Ask user whether to continue
    again = input("\nWould you like to perform another calculation? (yes/no): ")

    if again.lower() != "yes":
        print(" Thanks for using victors calculator")
        break

