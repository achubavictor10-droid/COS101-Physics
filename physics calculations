
# PYTHON PROGRAM FOR 5 PHYSICS FORMULAS

print("===== FIVE PHYSICS FORMULAS =====")

# 1. SPEED = DISTANCE / TIME
distance = 100
time = 20
speed = distance / time

print("\n1. SPEED")
print("Distance =", distance, "m")
print("Time =", time, "s")
print("Speed =", speed, "m/s")


# 2. FORCE = MASS × ACCELERATION
mass = 10
acceleration = 5
force = mass * acceleration

print("\n2. FORCE")
print("Mass =", mass, "kg")
print("Acceleration =", acceleration, "m/s^2")
print("Force =", force, "N")


# 3. WORK DONE = FORCE × DISTANCE
force = 20
distance = 5
work = force * distance

print("\n3. WORK DONE")
print("Force =", force, "N")
print("Distance =", distance, "m")
print("Work Done =", work, "J")


# 4. DENSITY = MASS / VOLUME
mass = 50
volume = 10
density = mass / volume

print("\n4. DENSITY")
print("Mass =", mass, "kg")
print("Volume =", volume, "m^3")
print("Density =", density, "kg/m^3")


# 5. POWER = WORK DONE / TIME
work = 200
time = 10
power = work / time

print("\n5. POWER")
print("Work Done =", work, "J")
print("Time =", time, "s")
print("Power =", power, "Watts")


print("\n===== END OF PROGRAM =====")
