
# Python Program for 5 Physics Formulas

print("=== FIVE PHYSICS FORMULAS ===")

# 1. Speed = Distance / Time
distance = float(input("Enter distance (meters): "))
time = float(input("Enter time (seconds): "))
speed = distance / time
print("1. Speed =", speed, "m/s")

# 2. Force = Mass × Acceleration
mass = float(input("\nEnter mass (kg): "))
acceleration = float(input("Enter acceleration (m/s²): "))
force = mass * acceleration
print("2. Force =", force, "Newtons")

# 3. Work Done = Force × Distance
force = float(input("\nEnter force (N): "))
distance = float(input("Enter distance (m): "))
work = force * distance
print("3. Work Done =", work, "Joules")

# 4. Density = Mass / Volume
mass = float(input("\nEnter mass (kg): "))
volume = float(input("Enter volume (m³): "))
density = mass / volume
print("4. Density =", density, "kg/m³")

# 5. Power = Work Done / Time
work = float(input("\nEnter work done (J): "))
time = float(input("Enter time (s): "))
power = work / time
print("5. Power =", power, "Watts")

print("\n=== CALCULATIONS COMPLETED ===")
