def calculate_kinetic_energy(mass: float, velocity: float) -> float:
"""Calculates Kinetic Energy: KE = 0.5 * m * v^2"""
return 0.5 * mass * (velocity ** 2)

def calculate_force(mass: float, acceleration: float) -> float:
"""Calculates Force (Newton's Second Law): F = m * a"""
return mass * acceleration

def calculate_potential_energy(mass: float, height: float, gravity: float = 9.81) -> float:
"""Calculates Gravitational Potential Energy: PE = m * g * h"""
return mass * gravity * height

def calculate_voltage(current: float, resistance: float) -> float:
"""Calculates Voltage (Ohm's Law): V = I * R"""
return current * resistance

def calculate_wave_speed(frequency: float, wavelength: float) -> float:
"""Calculates Wave Speed: v = f * lambda"""
return frequency * wavelength

